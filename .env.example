# cp .env.example .env  → заполнить. Файл .env НЕ коммитится.

# ── Ключи ──────────────────────────────────────────────
OPENAI_API_KEY=
NVIDIA_API_KEY=            # nvapi-...  (build.nvidia.com → API keys)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # по умолчанию
# Если организаторы дадут свой прокси/эндпоинт (OpenAI-совместимый):
# CUSTOM_BASE_URL=
# CUSTOM_API_KEY=

# ── Модели: "провайдер:модель" ─────────────────────────
# Список доступных:  python cli.py models openai   /   python cli.py models nvidia
# Проверка всех:     python cli.py check
MODEL_SMART=openai:gpt-5-mini
MODEL_SMART_FALLBACK=nvidia:meta/llama-3.3-70b-instruct
MODEL_FAST=nvidia:meta/llama-3.3-70b-instruct
MODEL_FAST_FALLBACK=openai:gpt-5-mini
MODEL_EMBED=openai:text-embedding-3-small
# вариант эмбеддингов на NVIDIA: MODEL_EMBED=nvidia:nvidia/nv-embedqa-e5-v5

# ── Лимиты ─────────────────────────────────────────────
MAX_STEPS=20
MAX_RUN_SECONDS=300
MAX_RUN_COST_USD=1.0
CONTEXT_MAX_TOKENS=60000
PARALLEL_TOOLS=true
REQUIRE_APPROVAL=false

# ── Прочее ─────────────────────────────────────────────
LLM_TIMEOUT=120
LLM_RETRIES=3
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Цены своих моделей (USD за 1M токенов вход/выход):
# PRICES_JSON={"my-model": [0.5, 1.5]}
